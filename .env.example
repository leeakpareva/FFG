# Copy to .env and fill in. .env is gitignored — this repo is public.

# --- Postgres (ffg-postgres, pgvector/pgvector:pg17) ---
POSTGRES_DB=ffg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Connection string used by the API layer (not yet built).
# From inside the navada-edge network use the container name:
DATABASE_URL=postgres://postgres:PASSWORD@ffg-postgres:5432/ffg
# From the ASUS host: postgres://postgres:PASSWORD@localhost:5435/ffg

# --- Clerk ---
# Publishable key is public by design and already committed in
# src/clerkConfig.js. The secret key is server-side only — never commit it.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Cloudflare R2 (planned, for member uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=navada-assets
